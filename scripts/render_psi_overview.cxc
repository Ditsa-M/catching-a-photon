# Renders for CHM 598 deck from public PDB 5OY0 (Synechocystis PSI; Malavath et al. 2018)
open ./5oy0.cif
set bgColor white
graphics silhouettes true width 1.6 color #2b2b2b
lighting soft
lighting shadows false
material dull
hide atoms
hide cartoons
# monomer = chains of the first protomer
show /A,B,C,D,E,F,I,J,K,L,M cartoons
cartoon style width 1.2 thick 0.3
color /A #c9d6e6 target c
color /B #e9d3c9 target c
color /C,D,E #d9e2d4 target c
color /F,I,J,K,L,M #e6e6ee target c
show (/A,B,F,I,J,K,L,M & :CLA) atoms
style :CLA stick
size :CLA stickRadius 0.12
color :CLA #7fb07f
hide :CLA & H
hide :CLA@C1,C2,C3,C4,C5,C6,C7,C8,C9,C10,C11,C12,C13,C14,C15,C16,C17,C18,C19,C20
show /A:1011,1012,1013 | /B:1021,1022,1023 atoms
size /A:1011,1012,1013 | /B:1021,1022,1023 stickRadius 0.28
color /A:1011 | /B:1021 #B45309
color /A:1012,1013 | /B:1022,1023 #0E7490
show (/A,B & :PQN) atoms
size :PQN stickRadius 0.28
color :PQN #7C3AED
show (/A,C & :SF4) atoms
style :SF4 sphere
color :SF4 #C9961A
view /A,B,C
turn x -90
view /A,B,C pad 0.03
save ./psi_overview.png width 2000 height 1500 supersample 3 transparentBackground true
# electron-transfer chain only, side view (membrane normal vertical)
hide cartoons
hide atoms
show /A:1011,1012,1013 | /B:1021,1022,1023 atoms
show (/A,B & :PQN) | (/A,C & :SF4) atoms
size stickRadius 0.25
view /A:1011,1012,1013,2001,3001 | /B:1021,1022,1023,2002 | /C:3002,3003
turn x -90
turn x 90
turn y 0
label /A:1011 | /B:1021 text "P700" height 2.4 color #B45309 bgColor #ffffffdd
label /A:1012 /B:1022 text "A-1" height 2.0 color #0E7490 bgColor #ffffffdd
label /A:1013 /B:1023 text "A0" height 2.0 color #0E7490 bgColor #ffffffdd
label /A:2001 /B:2002 text "A1" height 2.0 color #7C3AED bgColor #ffffffdd
label /A:3001 text "FX" height 2.2 color #8a6a10 bgColor #ffffffdd
label /C:3002 text "FA/FB" height 2.2 color #8a6a10 bgColor #ffffffdd
view /A:1011,1012,1013,2001,3001 | /B:1021,1022,1023,2002 | /C:3002,3003 pad 0.12
save ./psi_etc.png width 1600 height 1800 supersample 3 transparentBackground true
exit
